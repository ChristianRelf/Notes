{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notepad",
  "version": "1.0.0",
  "identifier": "com.relf.notepad",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Notepad",
        "width": 1080,
        "height": 720,
        "minWidth": 600,
        "minHeight": 380,
        "resizable": true,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "A plain-files note pad",
    "longDescription": "Notes as real .md and .txt files in one folder. Autosaves, searches instantly, never leaves the device."
  }
}
